{
	"name": "stellar-pay",
	"version": "0.1.10",
	"description": "Stellar payments layer for agents: a pay.sh-shaped client (curl that answers 402s with a Stellar wallet, x402 + MPP) over a probed catalog of Stellar-payable APIs. Private while the lane is new.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"probe": "STELLAR_PAY_ALLOW_DB=1 tsx --env-file-if-exists=.env src/probe.ts",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write . && tsc --noEmit",
		"pay": "tsx --env-file-if-exists=.env src/cli.ts",
		"sandbox": "tsx src/sandbox/testnet.ts",
		"probe:execute": "STELLAR_PAY_ALLOW_DB=1 tsx --env-file-if-exists=.env src/probe.ts --execute",
		"export": "STELLAR_PAY_ALLOW_DB=1 tsx --env-file-if-exists=.env src/export.ts",
		"mcp": "tsx --env-file-if-exists=.env src/cli.ts mcp",
		"test:mcp": "tsx src/sandbox/mcp-test.ts",
		"test:wallet": "tsx src/sandbox/wallet-test.ts",
		"test:keystore": "tsx src/sandbox/keystore-test.ts",
		"spike:vault": "tsx src/sandbox/vault-spike.ts",
		"test:proxy": "tsx src/sandbox/proxy-test.ts",
		"test:parity": "tsx src/sandbox/parity-test.ts",
		"test:verify": "tsx src/sandbox/verify-test.ts",
		"test:scrimp": "tsx src/sandbox/scrimp-test.ts",
		"test:ssrf": "tsx src/sandbox/ssrf-test.ts",
		"test:units": "tsx src/sandbox/unit-test.ts",
		"test:policy": "tsx src/sandbox/policy-test.ts",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build && npm run typecheck",
		"test:hostile": "tsx src/sandbox/hostile-test.ts",
		"test:redirect": "tsx src/sandbox/redirect-test.ts",
		"test:pin": "tsx src/sandbox/pin-test.ts",
		"test:keychain": "tsx src/sandbox/keychain-check.ts",
		"test:catalog": "tsx src/sandbox/catalog-test.ts",
		"test:send": "tsx src/sandbox/send-test.ts",
		"test:osstore": "tsx src/sandbox/osstore-test.ts",
		"test:session": "tsx src/sandbox/session-test.ts",
		"test:x402": "tsx src/sandbox/x402-test.ts",
		"test:receipts": "tsx src/sandbox/receipts-test.ts",
		"test:vault": "tsx src/sandbox/vault-test.ts",
		"test:session-ux": "tsx src/sandbox/session-ux-test.ts",
		"test:mcp-session": "tsx src/sandbox/mcp-session-test.ts",
		"test:job": "tsx src/sandbox/job-test.ts",
		"test:resolver": "tsx src/sandbox/resolver-test.ts",
		"test:bounty": "tsx src/sandbox/bounty-test.ts",
		"test:bounty-open": "tsx src/sandbox/bounty-open-test.ts",
		"test:vault-flow": "tsx src/sandbox/vault-flow-test.ts",
		"test:marketplace": "tsx src/sandbox/marketplace-test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
		"@types/express": "^5.0.6",
		"@types/node": "^22.10.2",
		"@types/node-forge": "^1.3.14",
		"@types/qrcode": "^1.5.6",
		"express": "^5.2.1",
		"mongodb": "^7.5.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@stellar/mpp": "^0.7.1",
		"@stellar/stellar-sdk": "^16.2.0",
		"@x402/core": "^2.23.0",
		"@x402/fetch": "^2.23.0",
		"@x402/stellar": "^2.23.0",
		"dotenv": "^17.4.2",
		"mppx": "^0.6.31",
		"node-forge": "^1.4.0",
		"qrcode": "^1.5.4",
		"smart-account-kit": "^0.6.2",
		"viem": "^2.55.19",
		"zod": "^4.4.3"
	},
	"bin": {
		"stellar-pay": "bin/stellar-pay.mjs"
	},
	"files": [
		"CONTRIBUTING.md",
		"PARITY.md",
		"README.md",
		"SECURITY.md",
		"bin",
		"dist",
		"docs",
		"llms.txt",
		"skills",
		"vendor"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./mcp": {
			"types": "./dist/mcp.d.ts",
			"import": "./dist/mcp.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Stellar-Light/stellar-pay.git"
	},
	"homepage": "https://github.com/Stellar-Light/stellar-pay#readme",
	"bugs": {
		"url": "https://github.com/Stellar-Light/stellar-pay/issues"
	},
	"keywords": [
		"stellar",
		"x402",
		"mpp",
		"agent",
		"payments",
		"usdc",
		"mcp",
		"402",
		"micropayments"
	]
}
